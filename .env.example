# ---------------------------------------------------------------
# Public values (inlined at build time: rebuild after changing them)
# ---------------------------------------------------------------
# Canonical production URL, without trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Public contact address. Leave empty to hide it.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional WhatsApp number override, international format, digits only.
# When empty, the number in src/config/site.ts is used.
NEXT_PUBLIC_WHATSAPP_PHONE=

# ---------------------------------------------------------------
# Database: Turso / libSQL (required in production)
# ---------------------------------------------------------------
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
# Local development only. Never set this in production: file databases
# are ephemeral on serverless hosts.
# ALLOW_LOCAL_DB=1
# TURSO_DATABASE_URL=file:./local.db

# ---------------------------------------------------------------
# Email notifications: Resend
# ---------------------------------------------------------------
RESEND_API_KEY=
# Must use a domain verified in Resend.
LEAD_EMAIL_FROM="Pulido Labs <web@your-domain.example>"
# Inbox that receives new-lead notifications.
LEAD_EMAIL_TO=you@your-domain.example

# ---------------------------------------------------------------
# Security
# ---------------------------------------------------------------
# Random secret used to hash IPs. Generate one with: openssl rand -hex 32
IP_HASH_SECRET=
# Optional rate limit overrides (defaults: 5 requests every 600 seconds).
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_SECONDS=600
